PORT=3000

# Proveedor de pagos: reap | kwal
PAYMENT_PROVIDER=reap

# --- Reap Agentic Payments ---
# La key llega por privado al líder del equipo. Nunca la pegues en el grupo ni en el repo.
REAP_API_KEY=
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_VERSION=2025-02-14
# Solo sandbox: simula que el usuario aprobó el checkout (útil para demos)
REAP_SIMULATE_CHECKOUT=false

# --- Kwal (Payward) ---
# Ruta absoluta al credentials.json que crea el skill agent-payment (fuera del repo),
# normalmente ~/.config/pws/agent-payment/credentials.json
KWAL_CREDENTIALS_FILE=
KWAL_SERVICE_URL=https://api.sandbox.services.payward.com
KWAL_EXPLORER_URL=https://explorer-sepolia.inkonchain.com

# --- Supabase (para validar el JWT del usuario de la app) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para npm run setup:supabase: Supabase → Connect → Session pooler (URI)
SUPABASE_DB_URL=

# URL pública HTTPS de este backend (Reap redirige aquí tras la aprobación)
PUBLIC_BASE_URL=https://tu-backend.vercel.app
# Deep link de la app al que se reenvía al usuario
APP_DEEP_LINK=transfertronix://agentic/return
